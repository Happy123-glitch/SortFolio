# ==============================================================================
# Sortfolio Environment Configuration Template
# COPY this file to .env and provide your actual values.
# NEVER commit .env to GitHub.
# ==============================================================================

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-server-only

# GitHub API Access (Optional for public repos, recommended to prevent rate limits)
GITHUB_TOKEN=your-github-personal-access-token

# Open-Weight AI Model Configuration (Qwen 2.5 7B recommended)
# Allowed: Ollama, HuggingFace, Groq, OpenRouter, vLLM
# PROHIBITED: Closed APIs (OpenAI, Claude, Gemini)
OPEN_WEIGHT_MODEL_PROVIDER=ollama
OPEN_WEIGHT_MODEL_ID=qwen2.5:7b
OPEN_WEIGHT_MODEL_BASE_URL=http://localhost:11434
OPEN_WEIGHT_MODEL_API_KEY=
